# ────────────────────────────────────────────
#  YOLO Mobile — Environment Variables
# ────────────────────────────────────────────
#
# Copy this file to .env and fill in the values.
# These are passed to the Flutter build via --dart-define.
#
# Example build command:
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi... \
#     --dart-define=R2_PUBLIC_URL=https://pub-xxx.r2.dev
#

# Required: Your Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Required: Your Supabase anonymous/public API key
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: Cloudflare R2 public endpoint for model file downloads.
# Leave empty if using pre-signed URLs via Supabase edge functions.
R2_PUBLIC_URL=
